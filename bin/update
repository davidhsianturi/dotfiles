#!/bin/bash
#
# Update dotfiles and tools

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

step() { echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }

echo ""
step "Updating dotfiles"
echo ""

# Update dotfiles repo
step "Pulling latest changes"
git -C ~/.dotfiles pull origin main
success "Dotfiles updated"

DOTFILES_DIR="$HOME/.dotfiles"
# move this to install-boost
step "Updating symlinks"
rm -rf ~/.agents/skills
ln -sf "$DOTFILES_DIR/boost/skills/.agents/skills" ~/.agents/skills
rm -rf ~/.agents/skills-lock.json
ln -sf "$DOTFILES_DIR/boost/skills/skills-lock.json" ~/.agents/skills-lock.json
success "Symlinks updated"

# Update Homebrew and packages
step "Updating Homebrew packages"
brew update
brew upgrade
brew bundle --file=~/.dotfiles/Brewfile
brew cleanup
success "Homebrew packages updated"

# Update global npm packages
step "Updating global npm packages"
npm update -g
success "npm packages updated"

# Update global Composer packages
step "Updating global Composer packages"
composer global update
success "Composer packages updated"

# Reload shell config
echo ""
success "Update complete!"
echo ""
warn "Restart your terminal or run: exec zsh"
echo ""